---
const MAPA_EMBED_URL =
  "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3282.826567849294!2d-58.5095708!3d-34.6338228!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x95bcc8355a355a4d%3A0x8a52623b37592bb8!2sC.%20Irigoyen%20642%2C%20C1407CAP%20Cdad.%20Aut%C3%B3noma%20de%20Buenos%20Aires!5e0!3m2!1ses!2sar!4v1795525368644!5m2!1ses!2sar";

const MAPA_ENLACE_URL =
  "https://www.google.com/maps/place/C.+Irigoyen+642,+C1407CAP+CABA/@-34.6338228,-58.5095708,17z";
---

<section
  id="ubicacion"
  class="ubicacion"
  aria-labelledby="ubicacion-titulo"
  data-ubicacion
>
  <div class="ubicacion__mapa fade-up" style="--d: 0s">
    <iframe
      class="ubicacion__iframe"
      src={MAPA_EMBED_URL}
      title="Mapa del consultorio de Pablo Gago"
      loading="lazy"
      referrerpolicy="strict-origin-when-cross-origin"
      allowfullscreen></iframe>
  </div>

  <div class="ubicacion__info">
    <div class="ubicacion__cabecera">
      <h2
        id="ubicacion-titulo"
        class="ubicacion__titulo fade-up"
        style="--d: 0.08s"
      >
        Te espero en<br />el consultorio
      </h2>
      <p class="ubicacion__bajada fade-up" style="--d: 0.16s">
        Kinesiología y fisiatría en CABA
      </p>
    </div>

    <div class="ubicacion__detalle">
      <p class="ubicacion__datos fade-up" style="--d: 0.24s">
        C. Irigoyen 642, CABA. Atiendo de lunes a viernes de 16:00 a 20:00,
        siempre con turno previo.
      </p>
      <div class="ubicacion__cta fade-up" style="--d: 0.32s">
        <a
          href={MAPA_ENLACE_URL}
          class="ubicacion__boton"
          target="_blank"
          rel="noopener"
        >
          <span>Ver en Google Maps</span>
          <svg
            class="ubicacion__boton-icono"
            viewBox="0 0 16 16"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M4.5 11.5L11.5 4.5"></path>
            <path d="M5.5 4.5h6v6"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Sin JavaScript: todo visible en su estado final -->
  <noscript>
    <style is:inline>
      .ubicacion .fade-up {
        opacity: 1 !important;
        transform: none !important;
      }
    </style>
  </noscript>
</section>

<script>
  const seccion = document.querySelector<HTMLElement>("[data-ubicacion]");
  const reducirMovimiento = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  if (seccion) {
    if (reducirMovimiento || !("IntersectionObserver" in window)) {
      seccion.classList.add("is-visible");
    } else {
      const umbral = Math.min(
        0.2,
        (window.innerHeight * 0.5) / Math.max(seccion.offsetHeight, 1),
      );
      const observador = new IntersectionObserver(
        (entradas) => {
          if (entradas.some((e) => e.isIntersecting)) {
            seccion.classList.add("is-visible");
            observador.disconnect();
          }
        },
        { threshold: umbral },
      );
      observador.observe(seccion);
    }
  }
</script>

<style>
  .ubicacion {
    position: relative;
    z-index: 2;
    min-height: 100vh;
    padding: 12px 12px 64px;
    background-color: var(--blanco);
    background-image: linear-gradient(
      180deg,
      var(--celeste) 0%,
      var(--blanco) 100%
    );
    color: var(--azul-noche);
  }

  .ubicacion__mapa {
    width: 100%;
    /* 556 px a 832 px de alto; reserva 276 px para que el bloque inferior entre en pantalla */
    height: clamp(320px, calc(100vh - 276px), 840px);
    border-radius: 24px;
    overflow: hidden;
    background-color: var(--fondo-claro);
  }

  .ubicacion__iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .ubicacion__info {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 380px);
    column-gap: clamp(32px, 5vw, 80px);
    align-items: start;
    /* Izquierda: 12 + 28 = 40 px; derecha: 12 + 70 = 82 px a partir de 1280 px */
    padding: 48px clamp(28px, -47.07px + 9.15vw, 70px) 0 28px;
  }

  .ubicacion__cabecera {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .ubicacion__titulo {
    /* 36 px en 820 px → 44 px en 1280 px+ */
    font-size: clamp(2.25rem, 1.359rem + 1.739vw, 2.75rem);
    font-weight: var(--peso-medium);
    line-height: 1.08;
    letter-spacing: var(--tracking-titular);
    color: var(--azul-noche);
  }

  .ubicacion__bajada {
    font-size: 0.9375rem;
    font-weight: var(--peso-regular);
    line-height: 1.4;
    color: var(--texto-secundario);
  }

  .ubicacion__detalle {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    padding-top: 4px;
  }

  .ubicacion__datos {
    font-size: 1rem;
    font-weight: var(--peso-regular);
    line-height: var(--interlineado-cuerpo);
    color: var(--texto-secundario);
  }

  .ubicacion__cta {
    display: inline-flex;
  }

  .ubicacion__boton {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 46px;
    padding: 14px 18px 14px 22px;
    border-radius: var(--radio-pastilla);
    background-color: var(--azul-noche);
    color: var(--blanco);
    font-size: 0.9375rem;
    font-weight: var(--peso-medium);
    line-height: 1.2;
    white-space: nowrap;
    transition: opacity 0.2s ease;
  }

  .ubicacion__boton:focus-visible {
    outline: 2px solid var(--azul-noche);
    outline-offset: 3px;
  }

  .ubicacion__boton-icono {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  @media (hover: hover) {
    .ubicacion__boton:hover {
      opacity: 0.92;
    }

    .ubicacion__boton:hover .ubicacion__boton-icono {
      transform: translate(2px, -2px);
    }
  }

  /* ── Tablet (640–1023 px; base 834 px — ver tokens.css) ─────────────── */

  @media (min-width: 640px) and (max-width: 1023px) {
    .ubicacion {
      min-height: auto;
      padding: 12px 12px 72px;
    }

    .ubicacion__mapa {
      /* 810 × 480 exactos en 834 px; acotado a 60svh para entrar cómodo en tablet horizontal */
      height: clamp(420px, min(240px + 28.78vw, 60svh), 520px);
      border-radius: 24px;
    }

    .ubicacion__info {
      /* En 834 px: izq. en x = 40 (y = 540), der. en x = 429 con 365 px de ancho */
      grid-template-columns: minmax(0, 349fr) minmax(0, 365fr);
      column-gap: clamp(24px, 4.8vw, 48px);
      padding: 48px 28px 0 28px;
    }

    .ubicacion__cabecera {
      /* Titular (y = 540..626,4) + 14 = bajada en y = 640 */
      gap: 14px;
    }

    .ubicacion__titulo {
      /* 32 px en 640 px → 40 px exactos en 834 px → 42 px en 1023 px */
      font-size: clamp(2rem, 0.35rem + 4.124vw, 2.625rem);
    }

    .ubicacion__detalle {
      /* Datos en y = 544 (3 líneas = 72 px) + 24 = botón en y = 640 */
      padding-top: 4px;
      gap: 24px;
    }

    .ubicacion__datos {
      font-size: 1rem;
      max-width: 380px;
    }
  }

  /* ── Celular (< 640 px; base 393 px — ver --bp-celular-max en tokens.css) ─ */

  @media (max-width: 639px) {
    .ubicacion {
      min-height: auto;
      padding: 12px 12px 64px;
    }

    .ubicacion__mapa {
      /* 440 px en 393 px → 540 px en 768 px+ */
      height: clamp(440px, 335px + 26.7vw, 540px);
      border-radius: 20px;
    }

    .ubicacion__info {
      grid-template-columns: 1fr;
      row-gap: 24px;
      padding: 36px 12px 0;
    }

    .ubicacion__cabecera {
      gap: 12px;
    }

    .ubicacion__titulo {
      font-size: 2.25rem;
    }

    .ubicacion__detalle {
      padding-top: 0;
      gap: 12px;
      max-width: 420px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ubicacion__boton,
    .ubicacion__boton-icono,
    .ubicacion__boton:hover .ubicacion__boton-icono {
      transition: none;
      transform: none;
    }
  }
</style>
