---
import { Image } from 'astro:assets';
import isotipo from '../assets/images/isotipo.png';
import Boton from './ui/Boton.astro';

const WHATSAPP_URL =
  'https://wa.me/5491156426761?text=Hola%20Pablo%2C%20quisiera%20reservar%20un%20turno.';

const enlaces = [
  { texto: 'Servicios', href: '#servicios' },
  { texto: 'Sobre mí', href: '#sobre-mi' },
  { texto: 'Testimonios', href: '#testimonios' },
  { texto: 'Consultorio', href: '#consultorio' },
  { texto: 'Ubicación', href: '#ubicacion' },
];
---

<header class="navbar-envoltura" data-navbar>
  <div class="navbar-fondo" data-menu-fondo aria-hidden="true"></div>

  <nav class="navbar" aria-label="Navegación principal" data-navbar-tarjeta>
    <div class="navbar__barra">
      <a href="#inicio" class="navbar__marca" data-navbar-marca>
        <Image
          src={isotipo}
          alt=""
          width={24}
          height={24}
          loading="eager"
          decoding="sync"
          class="navbar__isotipo"
        />
        <span class="navbar__nombre-envoltura">
          <span class="navbar__nombre">Pablo Gago</span>
        </span>
      </a>

      <ul class="navbar__enlaces">
        {
          enlaces.map(({ texto, href }) => (
            <li>
              <a href={href} class="navbar__enlace">
                {texto}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="navbar__acciones">
        <div class="navbar__cta" data-nav-cta inert>
          <Boton
            texto="Reservar turno"
            href={WHATSAPP_URL}
            variante="principal"
            tamaño="mini"
          />
        </div>
      </div>

      <button
        type="button"
        class="navbar__hamburguesa"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="menu-movil"
        data-menu-boton
      >
        <span class="navbar__linea"></span>
        <span class="navbar__linea"></span>
      </button>
    </div>

    <div id="menu-movil" class="menu-movil" data-menu-panel inert>
      <div class="menu-movil__interior">
        <div class="menu-movil__contenido">
          <ul class="menu-movil__lista">
            {
              enlaces.map(({ texto, href }, i) => (
                <li class="menu-movil__item" style={`--i: ${i}`}>
                  <a href={href} class="menu-movil__enlace" data-menu-enlace>
                    {texto}
                  </a>
                </li>
              ))
            }
          </ul>
          <div class="menu-movil__cta" style={`--i: ${enlaces.length}`}>
            <Boton
              texto="Reservar turno"
              href={WHATSAPP_URL}
              variante="principal"
              tamaño="normal"
            />
          </div>
        </div>
      </div>
    </div>
  </nav>
</header>

<script>
  import {
    INICIO_REVELADO_PROPUESTA,
    RANGO_REVELADO_PROPUESTA,
    UMBRAL_NAV_PROPUESTA,
    progresoReveladoPropuesta,
  } from '../scripts/revelar-letras';

  const mqlReducir = window.matchMedia('(prefers-reduced-motion: reduce)');
  const bpTabletMax =
    getComputedStyle(document.documentElement)
      .getPropertyValue('--bp-tablet-max')
      .trim() || '1023px';
  const mqlCompacta = window.matchMedia(`(max-width: ${bpTabletMax})`);

  const header = document.querySelector<HTMLElement>('[data-navbar]');
  const tarjeta = document.querySelector<HTMLElement>('[data-navbar-tarjeta]');
  const marca = document.querySelector<HTMLAnchorElement>('[data-navbar-marca]');
  const cta = document.querySelector<HTMLElement>('[data-nav-cta]');
  const frasePropuesta = document.querySelector<HTMLElement>(
    '[data-propuesta-frase]',
  );

  let ctaVisible = false;

  const sincronizarInertCta = () => {
    if (!header || !cta) return;
    const menuAbierto = header.classList.contains('menu-abierto');
    cta.inert = !ctaVisible || (menuAbierto && mqlCompacta.matches);
  };

  if (header && cta) {
    const actualizarCta = () => {
      ctaVisible = mqlReducir.matches
        ? frasePropuesta
          ? frasePropuesta.getBoundingClientRect().top < window.innerHeight
          : window.scrollY > window.innerHeight * 0.5
        : progresoReveladoPropuesta(window.scrollY / (window.innerHeight || 1)) >
          UMBRAL_NAV_PROPUESTA;
      header.classList.toggle('on', ctaVisible);
      sincronizarInertCta();
    };

    window.addEventListener('scroll', actualizarCta, { passive: true });
    window.addEventListener('resize', actualizarCta, { passive: true });
    mqlCompacta.addEventListener('change', sincronizarInertCta);
    actualizarCta();
  }

  // Calcula la posición de scroll donde Propuesta ya terminó de revelarse
  const posicionPropuestaRevelada = (): number | null => {
    const propuesta = document.getElementById('propuesta');
    if (!propuesta) return null;
    const inicioSeccion =
      propuesta.getBoundingClientRect().top + window.scrollY;
    if (mqlReducir.matches) return inicioSeccion;
    const alto = window.innerHeight || 1;
    const maxSticky = Math.max(
      inicioSeccion,
      inicioSeccion + propuesta.offsetHeight - alto,
    );
    const destinoRevelado =
      (INICIO_REVELADO_PROPUESTA + RANGO_REVELADO_PROPUESTA) * alto;
    return Math.min(Math.max(destinoRevelado, inicioSeccion), maxSticky);
  };

  const irASeccion = (href: string, actualizarHistorial = true): boolean => {
    if (!href.startsWith('#')) return false;
    const id = href.slice(1);
    const behavior: ScrollBehavior = mqlReducir.matches ? 'auto' : 'smooth';

    if (id === 'propuesta') {
      const destino = posicionPropuestaRevelada();
      if (destino === null) return false;
      window.scrollTo({ top: destino, behavior });
    } else if (id === 'inicio') {
      window.scrollTo({ top: 0, behavior });
    } else {
      const destino = document.getElementById(id);
      if (!destino) return false;
      destino.scrollIntoView({ behavior, block: 'start' });
    }

    if (actualizarHistorial && window.location.hash !== href) {
      window.history.pushState(null, '', href);
    }
    return true;
  };

  // Asegura que cualquier ancla hacia #propuesta lleve al texto ya revelado
  document.addEventListener('click', (evento) => {
    const objetivo =
      evento.target instanceof Element
        ? evento.target.closest<HTMLAnchorElement>('a[href="#propuesta"]')
        : null;
    if (!objetivo || objetivo.hasAttribute('data-menu-enlace')) return;
    evento.preventDefault();
    irASeccion('#propuesta');
  });

  window.addEventListener('hashchange', () => {
    if (window.location.hash === '#propuesta') {
      irASeccion('#propuesta', false);
    }
  });

  if (window.location.hash === '#propuesta') {
    requestAnimationFrame(() => irASeccion('#propuesta', false));
  }

  // Menú móvil
  const boton = document.querySelector<HTMLButtonElement>('[data-menu-boton]');
  const panel = document.querySelector<HTMLElement>('[data-menu-panel]');
  const fondo = document.querySelector<HTMLElement>('[data-menu-fondo]');
  const enlaces = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('[data-menu-enlace]'),
  );

  if (header && tarjeta && boton && panel) {
    const estaAbierto = () => boton.getAttribute('aria-expanded') === 'true';

    const bloquearScroll = () => {
      const anchoBarra =
        window.innerWidth - document.documentElement.clientWidth;
      document.documentElement.style.setProperty(
        '--compensacion-scroll',
        `${Math.max(0, anchoBarra)}px`,
      );
      document.documentElement.classList.add('menu-bloqueado');
    };

    const desbloquearScroll = () => {
      document.documentElement.classList.remove('menu-bloqueado');
      document.documentElement.style.removeProperty('--compensacion-scroll');
    };

    const obtenerEnfocables = (): HTMLElement[] => {
      const candidatos = tarjeta.querySelectorAll<HTMLElement>(
        'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])',
      );
      return Array.from(candidatos).filter((el) => {
        if (el.closest('[inert]')) return false;
        const estilo = getComputedStyle(el);
        return estilo.display !== 'none' && estilo.visibility !== 'hidden';
      });
    };

    const abrirMenu = () => {
      if (estaAbierto()) return;
      bloquearScroll();
      boton.setAttribute('aria-expanded', 'true');
      boton.setAttribute('aria-label', 'Cerrar menú de navegación');
      panel.inert = false;
      header.classList.add('menu-abierto');
      sincronizarInertCta();
      // Fuerza el cálculo de visibility: visible para mover el foco en el acto
      void panel.offsetHeight;
      enlaces[0]?.focus({ preventScroll: true });
    };

    const cerrarMenu = ({ devolverFoco = true } = {}) => {
      if (!estaAbierto()) return;
      boton.setAttribute('aria-expanded', 'false');
      boton.setAttribute('aria-label', 'Abrir menú de navegación');
      header.classList.remove('menu-abierto');
      panel.inert = true;
      desbloquearScroll();
      sincronizarInertCta();
      if (devolverFoco && mqlCompacta.matches) {
        boton.focus({ preventScroll: true });
      }
    };

    boton.addEventListener('click', () => {
      if (estaAbierto()) {
        cerrarMenu({ devolverFoco: true });
      } else {
        abrirMenu();
      }
    });

    fondo?.addEventListener('click', () => cerrarMenu({ devolverFoco: true }));
    fondo?.addEventListener(
      'touchmove',
      (evento) => {
        if (estaAbierto()) evento.preventDefault();
      },
      { passive: false },
    );

    marca?.addEventListener('click', (evento) => {
      if (!estaAbierto()) return;
      evento.preventDefault();
      cerrarMenu({ devolverFoco: true });
      irASeccion('#inicio');
    });

    enlaces.forEach((enlace) => {
      enlace.addEventListener('click', (evento) => {
        const href = enlace.getAttribute('href');
        if (href && href.startsWith('#')) {
          evento.preventDefault();
          cerrarMenu({ devolverFoco: true });
          irASeccion(href);
        } else {
          cerrarMenu({ devolverFoco: true });
        }
      });
    });

    document.addEventListener('keydown', (evento) => {
      if (!estaAbierto()) return;

      if (evento.key === 'Escape') {
        evento.preventDefault();
        cerrarMenu({ devolverFoco: true });
        return;
      }

      if (evento.key === 'Tab') {
        const enfocables = obtenerEnfocables();
        if (enfocables.length === 0) return;
        const primero = enfocables[0];
        const ultimo = enfocables[enfocables.length - 1];
        const activo = document.activeElement as HTMLElement | null;

        if (evento.shiftKey) {
          if (!activo || activo === primero || !tarjeta.contains(activo)) {
            evento.preventDefault();
            ultimo.focus();
          }
        } else {
          if (!activo || activo === ultimo || !tarjeta.contains(activo)) {
            evento.preventDefault();
            primero.focus();
          }
        }
      }
    });

    mqlCompacta.addEventListener('change', (evento) => {
      if (!evento.matches && estaAbierto()) {
        cerrarMenu({ devolverFoco: false });
      }
    });
  }
</script>

<style>
  .navbar-envoltura {
    --curva-menu: cubic-bezier(0.16, 1, 0.3, 1);
    position: fixed;
    top: 20px;
    left: 0;
    right: 0;
    z-index: 100;
    padding-left: var(--margen-x);
    padding-right: calc(var(--margen-x) + var(--compensacion-scroll, 0px));
    pointer-events: none;
  }

  .navbar-fondo {
    display: none;
  }

  .navbar {
    position: relative;
    z-index: 1;
    pointer-events: auto;
    max-width: 1296px;
    margin-inline: auto;
    background-color: var(--blanco);
    border-radius: var(--radio-pastilla);
    box-shadow: 0 4px 24px var(--sombra);
    opacity: 0;
    transform: translateY(-8px);
    animation: navbar-entrada 0.9s var(--curva-animacion) 0.15s forwards;
  }

  @keyframes navbar-entrada {
    to {
      opacity: 1;
      transform: none;
    }
  }

  .navbar__barra {
    height: 60px;
    padding: 0 8px 0 28px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
  }

  .navbar__marca {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    justify-self: start;
    border-radius: 6px;
  }

  .navbar__marca:focus-visible {
    outline: 2px solid var(--azul-noche);
    outline-offset: 4px;
  }

  .navbar__isotipo {
    width: 22px;
    height: 22px;
    object-fit: contain;
    flex-shrink: 0;
  }

  .navbar__nombre-envoltura {
    display: contents;
  }

  .navbar__nombre {
    font-size: 1rem;
    font-weight: var(--peso-medium);
    letter-spacing: -0.01em;
    color: var(--azul-noche);
    white-space: nowrap;
  }

  .navbar__enlaces {
    display: flex;
    align-items: center;
    gap: clamp(18px, 2.2vw, 32px);
  }

  .navbar__enlace {
    font-size: 0.9375rem;
    font-weight: var(--peso-regular);
    color: var(--azul-noche);
    opacity: 0.85;
    transition: opacity 0.2s ease;
    white-space: nowrap;
  }

  .navbar__enlace:hover,
  .navbar__enlace:focus-visible {
    opacity: 1;
  }

  .navbar__acciones {
    display: inline-flex;
    align-items: center;
    justify-self: end;
  }

  /* Botón mini: arranca oculto (círculo escala 0) y se abre punto → círculo → pastilla → texto */
  .navbar__cta {
    width: 44px;
    height: 44px;
    overflow: hidden;
    border-radius: var(--radio-pastilla);
    display: flex;
    align-items: center;
    justify-content: flex-end;
    transform: scale(0);
    transform-origin: 100% 50%;
    pointer-events: none;
    /* Secuencia inversa al volver arriba: se encoge la pastilla y luego desaparece el círculo */
    transition:
      width 0.48s var(--curva-animacion) 0.12s,
      transform 0.32s var(--curva-animacion) 0.46s;
  }

  .navbar__cta :global(.boton) {
    width: 173px;
    flex-shrink: 0;
  }

  .navbar__cta :global(.boton__texto) {
    opacity: 0;
    transition: opacity 0.18s ease 0s;
  }

  .navbar__cta :global(.boton__circulo) {
    transform: scale(0.28);
    transition: transform 0.28s var(--curva-animacion) 0.34s;
  }

  .navbar__cta :global(.boton__icono) {
    opacity: 0;
    transition:
      opacity 0.16s ease 0.24s,
      transform 0.2s ease;
  }

  /* Estado visible (clase .on cuando el revelado de Propuesta supera el 40 %) */
  .navbar-envoltura.on .navbar__cta {
    width: 173px;
    transform: scale(1);
    pointer-events: auto;
    transition:
      transform 0.35s var(--curva-animacion) 0s,
      width 0.65s var(--curva-animacion) 0.22s;
  }

  .navbar-envoltura.on .navbar__cta :global(.boton__circulo) {
    transform: scale(1);
    transition: transform 0.38s var(--curva-animacion) 0.14s;
  }

  .navbar-envoltura.on .navbar__cta :global(.boton__icono) {
    opacity: 1;
    transition:
      opacity 0.25s ease 0.28s,
      transform 0.2s ease;
  }

  .navbar-envoltura.on .navbar__cta :global(.boton__texto) {
    opacity: 1;
    transition: opacity 0.4s ease 0.45s;
  }

  .navbar__hamburguesa {
    display: none;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 6px;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    border-radius: 8px;
    background: transparent;
    cursor: pointer;
    justify-self: end;
  }

  .navbar__hamburguesa:focus-visible {
    outline: 2px solid var(--azul-noche);
    outline-offset: 2px;
  }

  /* Hamburguesa ↔ X en 0.35 s: primero se juntan al centro y luego rotan ±45° (y viceversa) */
  .navbar__linea {
    display: block;
    width: 22px;
    height: 1.75px;
    border-radius: 2px;
    background-color: var(--azul-noche);
    translate: 0 0;
    rotate: 0deg;
    transition:
      rotate 0.175s var(--curva-menu) 0s,
      translate 0.175s var(--curva-menu) 0.175s;
  }

  .navbar__hamburguesa[aria-expanded='true'] .navbar__linea {
    transition:
      translate 0.175s var(--curva-menu) 0s,
      rotate 0.175s var(--curva-menu) 0.175s;
  }

  .navbar__hamburguesa[aria-expanded='true'] .navbar__linea:first-child {
    translate: 0 3.875px;
    rotate: 45deg;
  }

  .navbar__hamburguesa[aria-expanded='true'] .navbar__linea:last-child {
    translate: 0 -3.875px;
    rotate: -45deg;
  }

  .menu-movil {
    display: none;
  }

  /* Versión compacta: tablet (640–1023 px) y celular (< 640 px) — ver tokens.css */
  @media (max-width: 1023px) {
    .navbar-envoltura {
      top: 16px;
    }

    .navbar-fondo {
      display: block;
      position: fixed;
      inset: 0;
      z-index: 0;
      background-color: color-mix(in srgb, var(--azul-noche) 20%, transparent);
      opacity: 0;
      pointer-events: none;
      touch-action: none;
      transition: opacity 0.3s ease 0.15s;
    }

    .navbar-envoltura.menu-abierto .navbar-fondo {
      opacity: 1;
      pointer-events: auto;
      transition: opacity 0.3s ease 0s;
    }

    /* 28 px = radio exacto de pastilla a 56 px de alto y coincide con la tarjeta abierta */
    .navbar {
      border-radius: 28px;
      transition:
        border-radius 0.5s var(--curva-menu) 0.2s,
        box-shadow 0.5s var(--curva-menu) 0.2s;
    }

    .navbar-envoltura.menu-abierto .navbar {
      border-radius: 28px;
      box-shadow:
        0 16px 40px color-mix(in srgb, var(--azul-noche) 14%, transparent),
        0 4px 16px var(--sombra);
      transition:
        border-radius 0.5s var(--curva-menu) 0s,
        box-shadow 0.5s var(--curva-menu) 0s;
    }

    /* Pastilla 738 × 56 en 834 px; padding-right 12 px compensa el área táctil de 40 px de la hamburguesa */
    .navbar__barra {
      grid-template-columns: auto 1fr auto;
      padding: 0 12px 0 18px;
      height: 56px;
      gap: 12px;
    }

    .navbar__enlaces {
      display: none;
    }

    .navbar__acciones {
      display: inline-flex;
      min-width: 0;
    }

    .navbar__cta {
      opacity: 1;
    }

    .navbar__cta:has(:focus-visible) {
      outline: 2px solid var(--azul-noche);
      outline-offset: 2px;
    }

    .navbar-envoltura.on:not(.menu-abierto) .navbar__cta {
      width: 173px;
      opacity: 1;
      transform: scale(1);
      pointer-events: auto;
      transition:
        transform 0.35s var(--curva-animacion) 0s,
        width 0.65s var(--curva-animacion) 0.22s,
        opacity 0.2s ease 0s;
    }

    /* Mientras el menú está abierto se oculta el mini botón (abajo ya está el principal) */
    .navbar-envoltura.on.menu-abierto .navbar__cta {
      width: 44px;
      opacity: 0;
      transform: scale(0);
      pointer-events: none;
      transition:
        opacity 0.18s ease 0s,
        transform 0.2s var(--curva-animacion) 0s,
        width 0.2s var(--curva-animacion) 0s;
    }

    .navbar-envoltura.on.menu-abierto .navbar__cta :global(.boton__texto),
    .navbar-envoltura.on.menu-abierto .navbar__cta :global(.boton__icono) {
      opacity: 0;
      transition: opacity 0.12s ease 0s;
    }

    .navbar-envoltura.on.menu-abierto .navbar__cta :global(.boton__circulo) {
      transform: scale(0.28);
      transition: transform 0.18s var(--curva-animacion) 0s;
    }

    .navbar__hamburguesa {
      display: inline-flex;
    }

    .menu-movil {
      display: grid;
      grid-template-rows: 0fr;
      visibility: hidden;
      /* Al cerrar: espera 0.2 s a que se desvanezcan enlaces y botón antes de achicar la tarjeta */
      transition:
        grid-template-rows 0.5s var(--curva-menu) 0.2s,
        visibility 0s linear 0.7s;
    }

    .navbar-envoltura.menu-abierto .menu-movil {
      grid-template-rows: 1fr;
      visibility: visible;
      transition:
        grid-template-rows 0.5s var(--curva-menu) 0s,
        visibility 0s linear 0s;
    }

    .menu-movil__interior {
      overflow: hidden;
      min-height: 0;
    }

    .menu-movil__contenido {
      padding: 14px 18px 24px;
    }

    .menu-movil__lista {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .menu-movil__item,
    .menu-movil__cta {
      opacity: 0;
      transform: translateY(10px);
      transition:
        opacity 0.2s ease 0s,
        transform 0s linear 0.2s;
    }

    .navbar-envoltura.menu-abierto .menu-movil__item,
    .navbar-envoltura.menu-abierto .menu-movil__cta {
      opacity: 1;
      transform: translateY(0);
      transition:
        opacity 0.35s var(--curva-menu) calc(0.15s + var(--i, 0) * 0.04s),
        transform 0.35s var(--curva-menu) calc(0.15s + var(--i, 0) * 0.04s);
    }

    .menu-movil__enlace {
      display: inline-block;
      padding: 2px 0;
      font-size: 1.375rem;
      font-weight: var(--peso-medium);
      line-height: 1.25;
      letter-spacing: -0.02em;
      color: var(--azul-noche);
      border-radius: 6px;
      transition: opacity 0.2s ease;
    }

    .menu-movil__enlace:focus-visible {
      outline: 2px solid var(--azul-noche);
      outline-offset: 4px;
    }

    .menu-movil__cta {
      margin-top: 24px;
    }

    /* Botón principal de tamaño celular (177 × 46) en toda la vista compacta */
    .menu-movil__cta :global(.boton.boton--normal) {
      height: 46px;
      padding: 5px 5px 5px 20px;
      gap: 14px;
      font-size: 0.9375rem;
    }

    .menu-movil__cta :global(.boton.boton--normal .boton__circulo) {
      width: 36px;
      height: 36px;
    }

    .menu-movil__cta :global(.boton.boton--normal .boton__icono) {
      width: 16px;
      height: 16px;
    }
  }

  /* Celular (< 640 px; ver --bp-celular-max en tokens.css): marca colapsa y botón mini compacto */
  @media (max-width: 639px) {
    .navbar-envoltura {
